+// Benchmark-only override. This patch lives in the performance repository.
+fn benchmark_l4_read_size(value: Option<&str>) -> Result<usize> {
+    match value {
+        None | Some("65536") => Ok(65_536),
+        Some("32768") => Ok(32_768),
+        Some("16384") => Ok(16_384),
+        _ => Err(Error::explain(
+            ErrorType::InternalError,
+            "invalid benchmark L4 read size",
+        )),
+    }
+}
