+// Benchmark-only setting; this patch is kept in the performance repository.
+fn configure_benchmark_tls_offload(settings: &mut TlsSettings) {
+    let threads = match std::env::var("TAKO_BENCH_TLS_OFFLOAD").as_deref() {
+        Err(_) | Ok("0") => return,
+        Ok("1") => 1,
+        Ok("2") => 2,
+        _ => panic!("invalid benchmark TLS offload thread count"),
+    };
+    settings.set_offload_threadpool(1, threads);
+}
